{"Version":"2012-10-17","Statement":[
{"Sid":"List","Effect":"Allow","Action":["s3:ListBucket","s3:GetBucketLocation"],"Resource":"arn:aws:s3:::<NEFF_CACHE_BUCKET>"},
{"Sid":"RW","Effect":"Allow","Action":["s3:GetObject","s3:PutObject","s3:AbortMultipartUpload","s3:ListMultipartUploadParts"],"Resource":"arn:aws:s3:::<NEFF_CACHE_BUCKET>/*"},
{"Sid":"DeleteLocksOnly","Effect":"Allow","Action":"s3:DeleteObject","Resource":"arn:aws:s3:::<NEFF_CACHE_BUCKET>/*.lock"}]}
